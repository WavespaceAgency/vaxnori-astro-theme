---
import TableOfContents from "@/components/blog/TableOfContents.astro";
import JsonLd from "@/components/JsonLd.astro";
import CtaBanner from "@/components/sections/CtaBanner.astro";
import PageHero from "@/components/sections/PageHero.astro";
import Accordion from "@/components/ui/Accordion.astro";
import Container from "@/components/ui/Container.astro";
import Eyebrow from "@/components/ui/Eyebrow.astro";
import { faqPage } from "@/config/pages/faq";
import { homePage } from "@/config/pages/home";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { slugify } from "@/lib/utils";

// Every answer is visible on the page, so FAQPage structured data is allowed.
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqPage.groups.flatMap((g) =>
    g.items.map((i) => ({ "@type": "Question", name: i.question, acceptedAnswer: { "@type": "Answer", text: i.answer } })),
  ),
};
const topics = faqPage.groups.map((g) => ({ slug: slugify(g.label), text: g.label }));
---

<BaseLayout {...faqPage.meta}>
  <JsonLd slot="head" data={jsonLd} />
  <PageHero {...faqPage.hero} class="pb-[44px]" />
  <Container bordered class="grid border-t border-dashed border-t-line-strong lg:grid-cols-[minmax(0,399px)_minmax(0,800px)] lg:pr-[41px] lg:pb-[65px]">
    <aside class="hidden px-[40px] pt-10 lg:block">
      <div class="sticky top-24">
        <TableOfContents title="FAQ topics" headings={topics} size="lg" showTitle={false} />
      </div>
    </aside>
    <div class="border-dashed border-line-strong pb-6 lg:self-start lg:border-l lg:pb-0">
      {
        faqPage.groups.map((group, i) => (
          <section id={topics[i].slug} aria-label={group.label} class="scroll-mt-20">
            <div data-reveal class="px-6 pt-10 pb-2 lg:px-8 lg:pt-[48px]">
              <Eyebrow as="h2">{group.label}</Eyebrow>
            </div>
            <Accordion id={group.id} items={group.items} variant="dashed" lastBorder defaultOpen={group.id === "getting-started" ? 0 : null} />
          </section>
        ))
      }
    </div>
  </Container>
  <!-- Black CTA band + 50px gap before the footer (Figma FAQ page) -->
  <CtaBanner content={homePage.cta} id="faq-cta" bottomGap mobileSplit />
</BaseLayout>
