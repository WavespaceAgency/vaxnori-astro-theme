---
import Benefits from "@/components/careers/Benefits.astro";
import HiringProcess from "@/components/careers/HiringProcess.astro";
import RolesTable from "@/components/careers/RolesTable.astro";
import ValuesScroller from "@/components/careers/ValuesScroller.astro";
import CtaBanner from "@/components/sections/CtaBanner.astro";
import PageHero from "@/components/sections/PageHero.astro";
import Container from "@/components/ui/Container.astro";
import { careersPage } from "@/config/pages/careers";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getJobs } from "@/lib/content";

const jobs = await getJobs();
---

<BaseLayout {...careersPage.meta}>
  <PageHero {...careersPage.hero} class="pb-[30px]" />
  <section aria-label="How we work">
    <Container bordered class="border-t border-dashed border-t-line-strong">
      <ValuesScroller values={careersPage.values} />
    </Container>
  </section>
  <!-- Phones show benefits first (as in the mobile design) -->
  <div class="flex flex-col">
    <div class="order-2 lg:order-1">
      <RolesTable jobs={jobs} {...careersPage.roles} />
    </div>
    <div class="order-1 lg:order-2">
      <Benefits {...careersPage.benefits} />
    </div>
  </div>
  <CtaBanner content={careersPage.cta} id="careers-cta" />
  <HiringProcess {...careersPage.hiring} />
</BaseLayout>
