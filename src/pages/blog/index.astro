---
import BlogList from "@/components/blog/BlogList.astro";
import LineIcon from "@/components/icons/LineIcon.astro";
import ScaleToFit from "@/components/motion/ScaleToFit.astro";
import CtaBanner from "@/components/sections/CtaBanner.astro";
import FeatureMockups from "@/components/sections/FeatureMockups.astro";
import PageHero from "@/components/sections/PageHero.astro";
import Container from "@/components/ui/Container.astro";
import Eyebrow from "@/components/ui/Eyebrow.astro";
import SectionHeading from "@/components/ui/SectionHeading.astro";
import { blogPage } from "@/config/pages/blog";
import { homePage } from "@/config/pages/home";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { formatDate, getPosts } from "@/lib/content";

const posts = await getPosts();
const featured = posts.find((post) => post.data.featured) ?? posts[0];
const rest = posts.filter((post) => post.id !== featured.id);
const f = featured.data;
const visual = homePage.features[0].visual;
---

<BaseLayout {...blogPage.meta}>
  <PageHero {...blogPage.hero} titleClass="sm:max-w-[936px]" class="pb-[30px]" />

  <!-- Featured post -->
  <section aria-labelledby="featured-title">
    <Container bordered class="border-t border-dashed border-t-line-strong bg-canvas">
      <div class="grid items-center gap-10 px-6 py-14 sm:px-8 lg:grid-cols-[minmax(0,556fr)_minmax(0,504fr)] lg:gap-20 lg:px-[50px] lg:py-[50px]">
        <div data-reveal class="flex flex-col gap-4">
          <Eyebrow class="flex-wrap tracking-[0.02em] lg:text-sm">
            {f.category}
            <span aria-hidden="true" class="size-0.5 rounded-full bg-brand"></span>
            <time datetime={f.date} class="text-grey-3">{formatDate(f.date)}</time>
            <span aria-hidden="true" class="size-0.5 rounded-full bg-brand"></span>
            <span class="text-grey-3">{f.readingTime}</span>
          </Eyebrow>
          <h2 id="featured-title" class="max-w-[460px] font-heading-flex text-2xl leading-8 font-medium tracking-[-0.03em] text-ink lg:text-[36px] lg:leading-[42px]">
            {f.title}
          </h2>
          <p class="max-w-[473px] text-sm leading-[22px] text-muted lg:text-base lg:leading-6">{f.excerpt}</p>
          <a href={`/blog/${featured.id}`} class="group mt-6 inline-flex w-fit items-center gap-2 text-sm font-semibold text-brand-strong">
            {blogPage.featuredCta}
            <LineIcon name="arrowRight" class="size-4 transition-transform duration-300 group-hover:translate-x-1" />
            <span class="sr-only">: {f.title}</span>
          </a>
        </div>
        <div data-reveal="scale" data-delay="0.1" class="w-full max-w-[504px] lg:justify-self-end">
          <div role="img" aria-label={f.imageAlt}>
            <ScaleToFit width={504} height={400}>
              {visual && <FeatureMockups visual={visual} />}
            </ScaleToFit>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- All posts -->
  <section aria-labelledby="posts-title">
    <Container bordered class="border-t border-dashed border-t-line-strong pt-14 lg:pt-[50px]">
      <div data-reveal class="mb-6 px-6 sm:px-8 lg:mb-[50px] lg:px-[50px]">
        <SectionHeading id="posts-title" eyebrow={blogPage.list.eyebrow} title={blogPage.list.title} accent={blogPage.list.accent} titleClass="max-w-[300px] lg:max-w-[420px]" />
      </div>
      <BlogList posts={rest} labels={blogPage.list} />
    </Container>
  </section>

  <CtaBanner content={homePage.cta} id="blog-cta" mobileSplit />
</BaseLayout>
