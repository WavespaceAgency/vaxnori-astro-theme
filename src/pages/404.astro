---
import PageHero from "@/components/sections/PageHero.astro";
import Container from "@/components/ui/Container.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<!-- 404 page (no Figma frame – built from the inner-page hero pattern) -->
<BaseLayout title="Page not found" noindex>
  <PageHero
    eyebrow="Error 404"
    title="This page wandered"
    accent="off the roadmap."
    description="The link may be old or the page may have moved. Head back home or tell us what you were looking for."
    primaryCta={{ label: "Back to home", href: "/" }}
    secondaryCta={{ label: "Contact us", href: "/contact" }}
  />
  <Container bordered class="bg-dots flex h-40 items-center justify-center lg:h-56">
    <p aria-hidden="true" class="font-pixel-line text-[96px] leading-none text-line-strong select-none lg:text-[160px]">404</p>
  </Container>
</BaseLayout>
