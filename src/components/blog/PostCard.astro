---
import { Image } from "astro:assets";
import { formatDate, type Post } from "@/lib/content";

interface Props {
  post: Post;
  readMore: string;
}
/** Blog card: image, category + date, title, excerpt, "Read more". The whole card is one link. */
const { post, readMore } = Astro.props;
const p = post.data;
---

<article class="group relative flex flex-col gap-4">
  <div class="relative aspect-[364/200] overflow-hidden rounded-card bg-[rgb(216_214_214/0.2)]">
    <Image
      src={p.image}
      alt={p.imageAlt}
      widths={[364, 728, 1092]}
      sizes="(min-width: 1024px) 364px, (min-width: 640px) 50vw, 100vw"
      quality={90}
      class="absolute inset-0 size-full object-cover transition-transform duration-700 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:scale-[1.04]"
    />
  </div>
  <div class="flex flex-col gap-3.5">
    <div class="flex items-center justify-between gap-3 text-[10px] tracking-[0.02em]">
      <span class="rounded-[3px] bg-line-soft px-1.5 pt-px pb-[3px] leading-[14px] font-medium text-muted">{p.category}</span>
      <span class="leading-4 text-grey-2">
        <time datetime={p.date}>{formatDate(p.date)}</time> • {p.readingTime.replace(" read", "")}
      </span>
    </div>
    <div class="flex flex-col gap-2">
      <h3 class="line-clamp-1 text-base leading-[1.21] font-semibold tracking-[0.02em] text-ink">
        <a href={`/blog/${post.id}`} class="after:absolute after:inset-0 focus-visible:outline-none">{p.title}</a>
      </h3>
      <p class="line-clamp-2 text-xs leading-4 tracking-[0.02em] text-grey-2">{p.excerpt}</p>
    </div>
    <span aria-hidden="true" class="text-xs leading-[14px] font-medium tracking-[0.02em] text-brand underline decoration-from-font underline-offset-2 transition-colors group-hover:text-brand-hover">
      {readMore}
    </span>
  </div>
</article>
