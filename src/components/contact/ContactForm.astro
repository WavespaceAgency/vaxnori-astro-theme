---
import { buttonClasses } from "@/lib/button";
import { fieldClasses } from "@/lib/field";
import { cn } from "@/lib/utils";

interface Props {
  labels: {
    fields: {
      name: { label: string; placeholder: string };
      email: { label: string; placeholder: string };
      company: { label: string; placeholder: string };
      topic: { label: string; options: readonly string[] };
      message: { label: string; placeholder: string };
    };
    submit: string;
    sending: string;
    note: string;
    success: string;
  };
}
/**
 * Contact form. Checks the fields in the browser, then calls `send()` in the script below.
 * TODO: connect your inbox or helpdesk in `send()` (a form service, Resend, Postmark, HubSpot, a webhook …).
 */
const { labels } = Astro.props;
const f = labels.fields;
const label = "text-sm leading-5 font-medium text-ink";
const error = "text-sm text-brand-strong";
---

<div data-contact data-sending={labels.sending} data-submit={labels.submit}>
  <form novalidate class="flex flex-col gap-6">
    <div class="flex flex-col gap-2">
      <label for="contact-name" class={label}>{f.name.label}</label>
      <input id="contact-name" name="name" type="text" autocomplete="name" placeholder={f.name.placeholder} class={fieldClasses} />
      <p id="contact-name-error" data-error-for="name" class={error} hidden></p>
    </div>
    <div class="flex flex-col gap-2">
      <label for="contact-email" class={label}>{f.email.label}</label>
      <input id="contact-email" name="email" type="email" autocomplete="email" inputmode="email" spellcheck="false" placeholder={f.email.placeholder} class={fieldClasses} />
      <p id="contact-email-error" data-error-for="email" class={error} hidden></p>
    </div>
    <div class="grid gap-6 sm:grid-cols-2 sm:gap-4">
      <div class="flex flex-col gap-2">
        <label for="contact-company" class={label}>{f.company.label}</label>
        <input id="contact-company" name="company" type="text" autocomplete="organization" placeholder={f.company.placeholder} class={fieldClasses} />
      </div>
      <div class="flex flex-col gap-2">
        <label for="contact-topic" class={label}>{f.topic.label}</label>
        <div class="relative">
          <select id="contact-topic" name="topic" class={cn(fieldClasses, "appearance-none pr-10")}>
            {f.topic.options.map((o) => <option>{o}</option>)}
          </select>
          <svg viewBox="0 0 24 24" class="pointer-events-none absolute top-1/2 right-3 size-4 -translate-y-1/2 text-subtle" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path d="m6 9 6 6 6-6"></path>
          </svg>
        </div>
      </div>
    </div>
    <div class="flex flex-col gap-2">
      <label for="contact-message" class={label}>{f.message.label}</label>
      <textarea id="contact-message" name="message" rows="4" placeholder={f.message.placeholder} class={cn(fieldClasses, "min-h-[94px] resize-y")}></textarea>
      <p id="contact-message-error" data-error-for="message" class={error} hidden></p>
    </div>
    <div class="flex flex-col gap-4">
      <button type="submit" class={buttonClasses({ size: "lg", className: "w-full" })}>{labels.submit}</button>
      <p class="text-sm leading-5 text-muted">{labels.note}</p>
    </div>
  </form>

  <div data-success role="status" tabindex="-1" hidden class="flex flex-col items-start gap-3 rounded-card border border-line bg-canvas p-6">
    <span class="flex size-10 items-center justify-center rounded-full bg-status-done-bg text-status-done">
      <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m5 12.5 4.5 4.5L19 7.5"></path></svg>
    </span>
    <p class="text-base leading-6 text-ink">{labels.success}</p>
  </div>
</div>

<script>
  import { animate } from "motion";
  import { EASE, reduceMotion } from "@/scripts/motion";

  type Message = { name: string; email: string; company: string; topic: string; message: string };

  /** TODO: send the message to your inbox or helpdesk. Throw an error to show a failure message. */
  async function send(data: Message) {
    console.info("[contact] TODO: send this message:", data);
  }

  const EMAIL = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

  document.querySelectorAll<HTMLElement>("[data-contact]").forEach((root) => {
    const form = root.querySelector("form")!;
    const submit = form.querySelector<HTMLButtonElement>("button[type=submit]")!;
    const success = root.querySelector<HTMLElement>("[data-success]")!;

    const setError = (name: string, message?: string) => {
      const field = form.elements.namedItem(name) as HTMLInputElement;
      const note = form.querySelector<HTMLElement>(`[data-error-for="${name}"]`)!;
      note.textContent = message ?? "";
      note.hidden = !message;
      if (message) {
        field.setAttribute("aria-invalid", "true");
        field.setAttribute("aria-describedby", note.id);
      } else {
        field.removeAttribute("aria-invalid");
        field.removeAttribute("aria-describedby");
      }
    };

    ["name", "email", "message"].forEach((name) =>
      (form.elements.namedItem(name) as HTMLInputElement).addEventListener("input", () => setError(name)),
    );

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const fd = new FormData(form);
      const data = Object.fromEntries(["name", "email", "company", "topic", "message"].map((k) => [k, String(fd.get(k) ?? "").trim()])) as Message;
      const errors: Record<string, string> = {};
      if (data.name.length < 2) errors.name = "Please enter your name.";
      if (!EMAIL.test(data.email)) errors.email = "Please enter a valid email address.";
      if (data.message.length < 10) errors.message = "Please write at least a short sentence (10+ characters).";
      ["name", "email", "message"].forEach((n) => setError(n, errors[n]));
      const first = Object.keys(errors)[0];
      if (first) {
        (form.elements.namedItem(first) as HTMLElement).focus();
        return;
      }

      submit.disabled = true;
      submit.textContent = root.dataset.sending ?? "";
      try {
        await send(data);
        form.hidden = true;
        success.hidden = false;
        success.focus();
        if (!reduceMotion()) animate(success, { opacity: [0, 1], y: [12, 0] }, { duration: 0.6, ease: EASE });
      } catch {
        setError("message", "Something went wrong. Please try again or email us.");
      } finally {
        submit.disabled = false;
        submit.textContent = root.dataset.submit ?? "";
      }
    });
  });
</script>
