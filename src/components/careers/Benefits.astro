---
import LineIcon from "@/components/icons/LineIcon.astro";
import type { LineIconName } from "@/components/icons/line-icons";
import Container from "@/components/ui/Container.astro";

interface Props {
  title: string;
  accent: string;
  items: readonly { icon: LineIconName; title: string; description: string }[];
}
/** "What comes with it" – 3×2 grid of benefits. */
const { title, accent, items } = Astro.props;
---

<section aria-labelledby="benefits-title">
  <Container bordered class="pt-14 lg:pt-[100px]">
    <div data-reveal class="px-6 pb-8 sm:px-8 lg:pb-[60px] lg:text-center">
      <h2 id="benefits-title" class="font-heading-flex text-[28px] leading-9 font-medium tracking-[-0.03em] text-ink lg:text-h2 lg:leading-[44px]">
        {title}{" "}<span class="font-pixel-line text-accent-text max-lg:block">{accent}</span>
      </h2>
    </div>
    <ul data-stagger data-gap="0.08" class="grid border-t border-dashed border-line-strong sm:grid-cols-2 lg:grid-cols-3">
      {
        items.map((item) => (
          <li
            data-stagger-item
            class="flex flex-col gap-8 border-b border-dashed border-line-strong px-6 py-7 sm:border-r lg:min-h-[272px] lg:gap-12 lg:px-10 lg:py-10 lg:[&:nth-child(3n)]:border-r-0"
          >
            <LineIcon name={item.icon} class="size-8 text-ink" />
            <div class="flex flex-col gap-2">
              <h3 class="font-heading-flex text-h4 font-medium text-ink">{item.title}</h3>
              <p class="text-sm leading-[22px] text-muted lg:text-base lg:leading-6">{item.description}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </Container>
</section>
