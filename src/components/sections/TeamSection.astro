---
import { Image } from "astro:assets";
import Container from "@/components/ui/Container.astro";
import SectionHeading from "@/components/ui/SectionHeading.astro";
import { getImage } from "@/lib/images";

interface Props {
  team: { eyebrow: string; title: string; accent: string; members: readonly { name: string; role: string; image: string }[] };
}
/** Team photo grid (About). */
const { team } = Astro.props;
---

<section aria-labelledby="team-title">
  <Container bordered class="px-6 py-14 sm:px-8 lg:px-[50px]">
    <div data-reveal>
      <SectionHeading id="team-title" eyebrow={team.eyebrow} title={team.title} accent={team.accent} titleClass="max-w-[300px] lg:max-w-[420px]" />
    </div>
    <ul data-stagger data-gap="0.1" class="mt-8 grid grid-cols-2 gap-x-4 gap-y-8 lg:grid-cols-4 lg:gap-6">
      {
        team.members.map((member) => (
          <li data-stagger-item class="group flex flex-col gap-4">
            <div class="relative aspect-[266/338] overflow-hidden bg-canvas">
              <Image
                src={getImage(member.image)}
                alt={`Portrait of ${member.name}`}
                widths={[267, 534]}
                sizes="(min-width: 1024px) 267px, 50vw"
                class="absolute inset-0 size-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
              />
            </div>
            <div class="flex flex-col gap-1.5">
              <h3 class="text-base leading-[19px] font-semibold tracking-[0.02em] text-ink lg:text-lg lg:leading-[22px]">{member.name}</h3>
              <p class="text-sm leading-[17px] text-[#6b6b6b] lg:text-base lg:leading-[19px]">{member.role}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </Container>
</section>
