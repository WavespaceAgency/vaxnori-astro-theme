---
import Container from "@/components/ui/Container.astro";
import Eyebrow from "@/components/ui/Eyebrow.astro";
import SectionHeading from "@/components/ui/SectionHeading.astro";
import type { HomePage } from "@/config/pages/home";
import { cn } from "@/lib/utils";
import StepCards from "./StepCards.astro";

type Row = { eyebrow: string; title: string; accent: string; description: string; card: HomePage["howItWorks"]["steps"][number]["card"] };
interface Props {
  content: { eyebrow: string; title: string; accent: string; rows: readonly Row[] };
}
/** How-it-works page: heading + three rows (text left, enlarged step card right). Desktop/tablet only. */
const { content } = Astro.props;
---

<section aria-labelledby="steps-title" id="steps" class="hidden md:block">
  <Container bordered class="pt-14 lg:pt-[50px]">
    <div data-reveal class="px-6 sm:px-8 lg:px-[50px]">
      <SectionHeading id="steps-title" eyebrow={content.eyebrow} title={content.title} accent={content.accent} titleClass="max-w-[300px] lg:max-w-[420px]" />
    </div>
    {
      content.rows.map((row, index) => (
        <article
          class={cn(
            "grid items-center gap-8 px-6 py-14 sm:px-8 lg:grid-cols-[556fr_504fr] lg:gap-20 lg:px-[50px]",
            index === 0 ? "lg:pt-0 lg:pb-[49px]" : "border-t border-dashed border-line-strong lg:py-12",
          )}
        >
          <div data-reveal class="flex max-w-[556px] flex-col gap-4">
            <div class="flex flex-col gap-3">
              <Eyebrow line={false}>{row.eyebrow}</Eyebrow>
              <h3 class="font-heading-flex text-2xl leading-7 font-medium tracking-[-0.03em] text-ink lg:text-[32px] lg:leading-[38px]">
                {row.title}{" "}<span class="block font-pixel-line text-accent-text">{row.accent}</span>
              </h3>
            </div>
            <p class="max-w-[473px] text-sm leading-5 text-muted lg:text-base lg:leading-6">{row.description}</p>
          </div>
          <div data-reveal="scale" data-delay="0.1" class="w-full max-w-[504px] lg:justify-self-end">
            <div aria-hidden="true" class="bg-dots flex aspect-[504/400] w-full max-w-[504px] items-center justify-center overflow-hidden">
              <div class="w-[206px] scale-[1.15] sm:scale-150">
                <StepCards card={row.card} />
              </div>
            </div>
          </div>
        </article>
      ))
    }
  </Container>
</section>
