---
import { render } from "astro:content";
import TableOfContents from "@/components/blog/TableOfContents.astro";
import { mdxComponents } from "@/components/mdx";
import Container from "@/components/ui/Container.astro";
import { homePage } from "@/config/pages/home";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { formatDate } from "@/lib/content";
import type { CollectionEntry } from "astro:content";
import CtaBanner from "./CtaBanner.astro";
import PageHero from "./PageHero.astro";

interface Props {
  entry: CollectionEntry<"legal">;
}
/** Shared layout for Privacy and Terms: hero + sticky contents list + MDX body (src/content/legal/*.mdx). */
const { entry } = Astro.props;
const meta = entry.data;
const { Content, headings } = await render(entry);
const toc = headings.filter((h) => h.depth === 2);
---

<BaseLayout title={`${meta.title} ${meta.accent}`} description={meta.description}>
  <PageHero eyebrow="Legal" title={meta.title} accent={meta.accent} description={`Last updated: ${formatDate(meta.updated, "long")}`} class="pb-[44px]" />
  <Container bordered class="grid border-t border-dashed border-t-line-strong lg:grid-cols-[minmax(0,355px)_minmax(0,885px)]">
    <aside class="hidden pt-10 pb-16 pl-10 lg:block">
      <div class="sticky top-24">
        <TableOfContents title="Contents" headings={toc} size="lg" showTitle={false} />
      </div>
    </aside>
    <article
      class="border-dashed border-line-strong px-6 pt-4 pb-14 lg:border-l lg:px-8 lg:pb-16 [&_h2]:mt-8 [&_h2]:mb-3 [&_h2]:font-sans [&_h2]:text-2xl [&_h2]:leading-8 [&_h2]:font-medium [&_p]:my-3 [&_p]:text-base [&_p]:leading-6"
    >
      <div class="max-w-[735px]">
        <Content components={mdxComponents} />
      </div>
    </article>
  </Container>
  <!-- Black CTA band + 50px gap before the footer (Figma Terms / Privacy) -->
  <CtaBanner content={homePage.cta} id="legal-cta" bottomGap mobileSplit />
</BaseLayout>
