---
import Button from "@/components/ui/Button.astro";
import Container from "@/components/ui/Container.astro";
import Eyebrow from "@/components/ui/Eyebrow.astro";
import { cn } from "@/lib/utils";
import CornerSquares from "./CornerSquares.astro";

type Cta = { label: string; href: string };
interface Props {
  eyebrow?: string;
  /** Eyebrow shown on phones only (Figma mobile frames). */
  mobileEyebrow?: string;
  title: string;
  accent: string;
  description?: string;
  primaryCta?: Cta;
  secondaryCta?: Cta;
  titleClass?: string;
  /** Let the accent words flow on the same line (default: own line). */
  accentInline?: boolean;
  class?: string;
}
/** Hero for inner pages (About, How it works, Pricing…): dotted band, corner squares, centred heading. Extra content goes in the slot. */
const { eyebrow, mobileEyebrow, title, accent, description, primaryCta, secondaryCta, titleClass, accentInline = false, class: className } = Astro.props;
---

<section aria-labelledby="page-title">
  <Container bordered class={cn("relative overflow-hidden", className)}>
    <div aria-hidden="true" class="bg-dots h-12 border-b border-line lg:h-[74px]"></div>
    <CornerSquares side="left" />
    <CornerSquares side="right" />

    <div class="relative px-[21px] pt-[72px] text-center sm:px-8 lg:pt-8">
      {
        (eyebrow || mobileEyebrow) && (
          <div class={cn("hero-reveal", !eyebrow && "lg:hidden")} style="--delay: 0.1s">
            <Eyebrow class="mb-2 justify-center lg:mb-3">{eyebrow ?? mobileEyebrow}</Eyebrow>
          </div>
        )
      }
      <div class="hero-reveal" style="--delay: 0.2s">
        <h1
          id="page-title"
          class={cn(
            "mx-auto max-w-[350px] font-heading-flex text-[32px] leading-10 font-medium tracking-[-0.03em] text-ink sm:max-w-[786px] sm:text-5xl sm:leading-[1.1] lg:text-display",
            titleClass,
          )}
        >
          {title}{" "}<span class={cn("font-pixel-line text-accent-text", !accentInline && "block")}>{accent}</span>
        </h1>
      </div>
      {
        description && (
          <div class="hero-reveal" style="--delay: 0.3s">
            <p class="mx-auto mt-4 max-w-[692px] text-sm leading-5 text-muted sm:mt-5 sm:text-lead sm:leading-[27px]">{description}</p>
          </div>
        )
      }
    </div>

    {
      (primaryCta || secondaryCta) && (
        <div class="mt-[42px] border-y border-dashed border-line-strong py-8 lg:mt-9">
          <div class="hero-reveal flex flex-wrap justify-center gap-4 px-4" style="--delay: 0.4s">
            {primaryCta && (
              <Button href={primaryCta.href} size="lg">
                {primaryCta.label}
              </Button>
            )}
            {secondaryCta && (
              <Button href={secondaryCta.href} size="lg" variant="secondary">
                {secondaryCta.label}
              </Button>
            )}
          </div>
        </div>
      )
    }
    <slot />
  </Container>
</section>
