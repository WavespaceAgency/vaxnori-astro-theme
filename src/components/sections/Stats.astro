---
import LineIcon from "@/components/icons/LineIcon.astro";
import type { LineIconName } from "@/components/icons/line-icons";
import Container from "@/components/ui/Container.astro";
import SectionHeading from "@/components/ui/SectionHeading.astro";
import { siteConfig } from "@/config/site";
import { cn } from "@/lib/utils";

type StatItem = { icon: LineIconName; value: string; label: string };
interface Props {
  content: { eyebrow?: string; title?: string; accent?: string; items: readonly StatItem[] };
}
const { content } = Astro.props;
const [a, b, c, d] = content.items;

/** Every cell draws its own right + bottom line; the grid draws the top + left line. */
const cell = "relative h-[223px] border-r border-b border-[#ededed] bg-surface p-6 lg:h-[264px]";
const stats = [
  { item: a, class: "max-sm:h-[205px] lg:col-span-3" },
  { item: b, class: "max-sm:h-[205px] lg:col-span-1" },
  { item: c, class: "lg:col-span-2" },
  { item: d, class: "lg:col-span-1" },
];
---

<section aria-labelledby={content.title ? "stats-title" : undefined} aria-label={content.title ? undefined : "Key numbers"}>
  <Container bordered class="bg-canvas px-6 py-14 sm:px-8 lg:px-[50px] lg:py-[60px]">
    {
      content.title && (
        <div data-reveal class="mb-6 lg:mb-12">
          <SectionHeading id="stats-title" eyebrow={content.eyebrow} title={content.title} accent={content.accent} titleClass="max-w-[300px] lg:max-w-[420px]" />
        </div>
      )
    }
    <div data-stagger data-gap="0.1" class="grid grid-cols-1 border-t border-l border-[#ededed] sm:grid-cols-2 lg:grid-cols-[294fr_98fr_393fr_61fr_294fr]">
      <!-- Brand mark drawn in light grey, using the logo file as a mask (follows your logo) -->
      <div data-stagger-item class={cn(cell, "flex items-center justify-center lg:col-span-1")}>
        <span
          aria-hidden="true"
          class="block aspect-[177/185] w-[150px] bg-[#f1f1f1] transition-colors duration-500 [mask-position:center] [mask-repeat:no-repeat] [mask-size:contain] hover:bg-brand-soft lg:w-[196px]"
          style={`mask-image: url(${siteConfig.brand.markAlt})`}
        ></span>
      </div>
      {
        stats.map(({ item, class: extra }) => (
          <div data-stagger-item class={cn(cell, "group flex flex-col justify-between gap-10 transition-colors duration-300 hover:bg-canvas", extra)}>
            <LineIcon name={item.icon} class="size-6 text-[#8a8a8a] transition-colors duration-300 group-hover:text-brand" />
            <div class="flex flex-col gap-3">
              <p class="font-heading-flex text-[32px] leading-10 font-medium tracking-[-0.03em] text-ink lg:text-h2 lg:leading-[44px]">
                <span class="sr-only">{item.value}</span>
                <span aria-hidden="true" data-count={item.value}>{item.value}</span>
              </p>
              <p class="text-sm leading-[22px] text-muted lg:text-base lg:leading-6">{item.label}</p>
            </div>
          </div>
        ))
      }
      <!-- Concentric diamonds that slowly pulse together -->
      <div data-stagger-item class={cn(cell, "flex items-center justify-center overflow-hidden lg:col-span-2")}>
        <span aria-hidden="true" class="relative flex size-[262px] scale-[0.85] items-center justify-center lg:scale-100">
          {
            [185, 150, 115, 80].map((size, i) => (
              <span
                class="absolute rotate-45 border-[0.5px] border-line-strong motion-safe:animate-pulse-soft"
                style={`width: ${size}px; height: ${size}px; animation-delay: ${i * 0.35}s; animation-duration: 3.2s`}
              />
            ))
          }
        </span>
      </div>
    </div>
  </Container>
</section>
