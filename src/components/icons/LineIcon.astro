---
import type { HTMLAttributes } from "astro/types";
import { lineIconPaths, type LineIconName } from "./line-icons";

interface Props extends HTMLAttributes<"svg"> {
  name: LineIconName;
}
const { name, ...attrs } = Astro.props;
---

<svg
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  {...attrs}
  set:html={lineIconPaths[name]}
/>
