---
import { cn } from "@/lib/utils";

export type AccordionItem = { question: string; answer: string };

const variants = {
  /** Dashed rows with large questions (home page FAQ). */
  dashed: {
    root: "",
    item: "border-b border-dashed border-line-strong px-6 py-6 last:border-b-0 lg:px-8 lg:py-8",
    hit: "before:-inset-x-6 before:-top-6 before:-bottom-3 lg:before:-inset-x-8 lg:before:-top-8 lg:before:-bottom-4",
    question: "font-heading-flex text-lg leading-6 font-medium tracking-[-0.03em] text-ink lg:text-h4",
    answer: "pt-2 pr-[72px] text-sm leading-[22px] lg:pr-[56px] lg:text-base lg:leading-6",
    icon: "top-6 right-6 lg:top-1/2 lg:right-8 lg:-translate-y-1/2",
  },
  /** Simple rows with solid lines. */
  simple: {
    root: "border-y border-line",
    item: "border-b border-line py-5 last:border-b-0",
    hit: "before:-inset-x-2 before:-top-5 before:-bottom-2.5",
    question: "text-base leading-6 font-medium text-ink",
    answer: "pt-2 pr-10 text-base leading-6",
    icon: "top-5 right-0",
  },
} as const;

interface Props {
  items: readonly AccordionItem[];
  /** Index open on load (null = all closed). */
  defaultOpen?: number | null;
  variant?: keyof typeof variants;
  headingLevel?: 2 | 3 | 4;
  /** Keep the dividing line under the last row too (FAQ page groups, as in Figma). */
  lastBorder?: boolean;
  /** Unique prefix for ids when there are several accordions on a page. */
  id?: string;
  /** Rows join a parent data-stagger group. */
  stagger?: boolean;
  class?: string;
}
/**
 * Accessible accordion (one item open at a time).
 * Answers stay in the HTML when closed, so search engines can read them.
 */
const { items, defaultOpen = 0, variant = "simple", headingLevel = 3, lastBorder = false, id = "faq", stagger = false, class: className } = Astro.props;
const v = variants[variant];
const itemClass = lastBorder ? v.item.replace(/\s?last:border-b-0/, "") : v.item;
const Heading = `h${headingLevel}` as "h2" | "h3" | "h4";
---

<div data-accordion class={cn(v.root, className)}>
  {
    items.map((item, index) => {
      const open = defaultOpen === index;
      const buttonId = `${id}-button-${index}`;
      const panelId = `${id}-panel-${index}`;
      return (
        <div data-acc-item data-stagger-item={stagger ? "" : undefined} class={cn("relative transition-colors hover:bg-canvas", itemClass)}>
          <Heading>
            <button
              id={buttonId}
              type="button"
              aria-expanded={open ? "true" : "false"}
              aria-controls={panelId}
              class={cn(
                // The ::before layer makes the whole row clickable (44px+ touch target).
                "relative flex w-full items-center justify-between gap-6 pr-10 text-left before:absolute before:content-[''] focus-visible:outline-offset-4",
                v.hit,
              )}
            >
              <span class={v.question}>{item.question}</span>
            </button>
          </Heading>
          {/* Icon stays vertically centred in the whole row (as in Figma) */}
          <svg
            aria-hidden="true"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            class={cn("pointer-events-none absolute size-6 text-brand", v.icon)}
          >
            <circle cx="12" cy="12" r="9" />
            <path d="M9 12h6" />
            <path data-plus-bar d="M12 9v6" style={`transform-box: fill-box; transform-origin: 50% 50%; transform: ${open ? "rotate(90deg) scaleY(0)" : "none"}`} />
          </svg>
          <div
            id={panelId}
            role="region"
            aria-labelledby={buttonId}
            aria-hidden={open ? undefined : "true"}
            inert={!open}
            class="overflow-hidden"
            style={open ? undefined : "height: 0; opacity: 0"}
          >
            <div data-answer class={cn("text-muted", v.answer)} style={open ? undefined : "transform: translateY(-8px)"}>
              {item.answer}
            </div>
          </div>
        </div>
      );
    })
  }
</div>

<script>
  import { animate } from "motion";
  import { EASE, reduceMotion } from "@/scripts/motion";

  document.querySelectorAll<HTMLElement>("[data-accordion]").forEach((root) => {
    const buttons = [...root.querySelectorAll<HTMLButtonElement>("button[aria-controls]")];

    const set = (button: HTMLButtonElement, open: boolean) => {
      if ((button.getAttribute("aria-expanded") === "true") === open) return;
      const panel = document.getElementById(button.getAttribute("aria-controls")!)!;
      const answer = panel.querySelector<HTMLElement>("[data-answer]")!;
      const bar = button.closest("[data-acc-item]")!.querySelector<SVGPathElement>("[data-plus-bar]");
      button.setAttribute("aria-expanded", String(open));
      panel.inert = !open;
      if (open) panel.removeAttribute("aria-hidden");
      else panel.setAttribute("aria-hidden", "true");

      const d = reduceMotion() ? 0 : 0.45;
      const from = panel.offsetHeight;
      const to = open ? panel.scrollHeight : 0;
      animate(panel, { height: [from, to], opacity: open ? 1 : 0 }, { duration: d, ease: EASE }).then(() => {
        if (button.getAttribute("aria-expanded") === "true") panel.style.height = "auto";
      });
      animate(answer, { y: open ? 0 : -8 }, { duration: d, ease: EASE });
      if (bar) animate(bar, { scaleY: open ? 0 : 1, rotate: open ? 90 : 0 }, { duration: reduceMotion() ? 0 : 0.35, ease: EASE });
    };

    buttons.forEach((button) =>
      button.addEventListener("click", () => {
        const opening = button.getAttribute("aria-expanded") !== "true";
        buttons.forEach((other) => other !== button && set(other, false));
        set(button, opening);
      }),
    );
  });
</script>
